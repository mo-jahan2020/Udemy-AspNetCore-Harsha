<div class="list-container">

 @{
     // اگر این کامنت را برداریم ویودیتای آمده از سوی کنترلر بروز رسانی خواهد شد
  //ViewBag.ListTitle = "Updated";
 }
 <!-- این ویو بگ از ویو دیتای داخل کنترلر مقدار دهی شده است پس مقادیر آن ویو بگ را نمایش دهیم-->
 <!-- ولی در قدوم بعدی ما ویو دیتای کاستوم خودمان را از ایندکس به این جا پاس میدهیم و این نمایش میدهد-->
 <h3>@ViewBag.ListTitle</h3>
 <ul class="list">
  @foreach (string item in ViewBag.ListItems)
  {
   <li>@item</li>
  }
 </ul>
</div>
