<!-- بخش ۸: اطلاعات محیط                                                    -->
<!-- ===================================================================== -->
<section class="section" id="section-env">
    <div class="section-header">
        <span class="section-number">08</span>
        <div>
            <h2 class="section-title">اطلاعات محیط اجرا</h2>
            <p class="section-desc">
                سرویس <code>IWebHostEnvironment</code> (سرویس داخلی ASP.NET Core) اطلاعات محیط را فراهم می‌کند.
            </p>
        </div>
    </div>

    <div class="env-grid">
        <div class="env-card">
            <div class="env-label">محیط اجرا (Environment)</div>
            <div class="env-value">@Model.EnvironmentName</div>
        </div>
        <div class="env-card">
            <div class="env-label">زمان درخواست</div>
            <div class="env-value env-value-mono">@Model.RequestTime.ToString("yyyy-MM-dd HH:mm:ss.fff")</div>
        </div>
        <div class="env-card">
            <div class="env-label">نسخه دات‌نت</div>
            <div class="env-value env-value-mono">@Environment.Version</div>
        </div>
        <div class="env-card">
            <div class="env-label">نوع پروژه</div>
            <div class="env-value">Standard MVC</div>
        </div>
    </div>
</section>
