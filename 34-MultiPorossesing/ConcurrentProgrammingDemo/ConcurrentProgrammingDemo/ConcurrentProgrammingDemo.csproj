<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ConcurrentProgrammingDemo</RootNamespace>
    <AssemblyName>ConcurrentProgrammingDemo</AssemblyName>
    <LangVersion>latest</LangVersion>
    <!-- System.Threading.Channels و System.Threading.Tasks.Dataflow به‌صورت خودکار در دات نت 10 موجود هستند -->
    <NoWarn>NU1510</NoWarn>
  </PropertyGroup>

</Project>
