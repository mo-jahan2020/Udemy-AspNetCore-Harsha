@using Microsoft.JSInterop
@* ====================================================================
   DownloadComponent.razor - کامپوننت Blazor Server
   ====================================================================
   این کامپوننت نشان می‌دهد چگونه از Blazor Server برای دانلود فایل
   استفاده کنیم. در Blazor ما نمی‌توانیم مستقیماً فایل دانلود کنیم،
   بنابراین از JavaScript Interop استفاده می‌کنیم.
   
   نکته آموزشی:
   - Blazor Server روی سرور اجرا می‌شود و از طریق WebSocket با مرورگر ارتباط دارد
   - برای عملیات مرورگر (مثل دانلود فایل) باید از JS Interop استفاده شود
   - @code بلاک شامل کد C# کامپوننت است
   - [Inject] برای تزریق وابستگی استفاده می‌شود
   ==================================================================== *@

<div class="blazor-section p-3 bg-light rounded-3">
    @* ============================================================
       نمایش وضعیت اتصال Blazor
       ============================================================ *@
    <h5 class="text-primary mb-2">
        <i class="bi bi-file-earmark-arrow-down"></i>
        دانلود با Blazor Server Component
    </h5>

    <p class="text-muted small mb-2">
        @* توضیح این روش برای کاربر *@
        در Blazor Server، کامپوننت روی سرور اجرا می‌شود.
        برای دانلود فایل از <code>JavaScript Interop</code> استفاده می‌کنیم.
        دکمه زیر یک تابع جاوااسکریپت را فراخوانی می‌کند.
    </p>

    @* ============================================================
       دکمه دانلود - با کلیک متد DownloadFile فراخوانی می‌شود
       ============================================================ *@
    <button class="btn btn-primary btn-sm" @onclick="DownloadFile" disabled="@_isDownloading">
        @if (_isDownloading)
        {
            @* نمایش وضعیت در حال دانلود *@
            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
            <span>در حال دانلود...</span>
        }
        else
        {
            @* نمایش عادی دکمه *@
            <i class="bi bi-download me-1"></i>
            <span>دانلود فایل با Blazor</span>
        }
    </button>

    @* ============================================================
       نمایش پیام نتیجه
       ============================================================ *@
    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert alert-success mt-2 py-1 px-2 small mb-0">
            @_message
        </div>
    }
</div>

@* ====================================================================
   بلاک کد C# کامپوننت Blazor
   ==================================================================== *@
@code {
    // ====================================================================
    // تزریق وابستگی (Dependency Injection)
    // ====================================================================

    /// <summary>
    /// IJSRuntime برای فراخوانی کدهای جاوااسکریپت از C#
    /// این سرویس به صورت خودکار توسط Blazor تزریق می‌شود
    /// </summary>
    [Inject]
    private IJSRuntime? JS { get; set; }

    // ====================================================================
    // فیلدهای وضعیت (State)
    // ====================================================================

    /// <summary>
    /// وضعیت دانلود - آیا در حال دانلود هستیم یا خیر
    /// برای نمایش Spinner روی دکمه استفاده می‌شود
    /// </summary>
    private bool _isDownloading = false;

    /// <summary>
    /// پیام نتیجه عملیات - پس از دانلود به کاربر نمایش داده می‌شود
    /// </summary>
    private string _message = string.Empty;

    /// <summary>
    /// روش ۱۲: دانلود فایل با استفاده از Blazor Server و JavaScript Interop
    /// 
    /// نکته آموزشی مهم:
    /// Blazor Server روی سرور اجرا می‌شود و دسترسی مستقیمی به مرورگر ندارد.
    /// برای عملیات‌های مرورگر (مثل دانلود فایل) باید از JS Interop استفاده کنیم.
    /// 
    /// مراحل کار:
    /// 1. کاربر روی دکمه کلیک می‌کند
    /// 2. متد C# اجرا می‌شود
    /// 3. متد C# یک تابع جاوااسکریپت را فراخوانی می‌کند
    /// 4. تابع جاوااسکریپت فایل را دانلود می‌کند
    /// </summary>
    private async Task DownloadFile()
    {
        try
        {
            // تنظیم وضعیت دانلود - دکمه غیرفعال و Spinner نمایش داده می‌شود
            _isDownloading = true;
            _message = string.Empty;

            // فراخوانی تابع جاوااسکریپت "blazorDownloadFile"
            // این تابع در فایل wwwroot/js/download.js تعریف شده است
            // InvokeVoidAsync چون مقدار برگشتی ندارد
            // پارامتر اول: نام تابع جاوااسکریپت
            // پارامترهای بعدی: آرگومان‌های تابع
            await JS!.InvokeVoidAsync("blazorDownloadFile",
                "/Download?handler=Download",  // آدرس فایل (Razor Page Handler)
                "blazor-download.pdf");         // نام فایل دانلود

            // نمایش پیام موفقیت
            _message = "فایل با موفقیت از طریق Blazor دانلود شد!";
        }
        catch (JSException ex)
        {
            // مدیریت خطای JavaScript Interop
            _message = $"خطا در دانلود: {ex.Message}";
        }
        finally
        {
            // بازگرداندن وضعیت به حالت عادی
            _isDownloading = false;

            // اطلاع‌رسانی به Blazor برای رندر مجدد کامپوننت
            // StateHasChanged به Blazor می‌گوید که وضعیت تغییر کرده و باید دوباره رندر شود
            StateHasChanged();
        }
    }
}