<!-- ====================================================================
     روش ۱۲: Blazor Server Component
     ==================================================================== -->
<div class="card method-card">
    <div class="card-header d-flex align-items-center">
        <span class="method-number">۱۲</span>
        <div>
            <strong>Blazor Server Component</strong>
            <span class="category-badge bg-dark text-white me-2">Blazor</span>
            <span class="category-badge bg-info text-white">JS Interop</span>
        </div>
    </div>
    <div class="card-body">
        <p class="method-description">
            در Blazor Server، کامپوننت روی سرور اجرا می‌شود و از طریق
            <strong>WebSocket</strong> با مرورگر ارتباط دارد.
            برای عملیات‌های مرورگر (مثل دانلود) باید از
            <code>JavaScript Interop</code> استفاده کنیم.
        </p>
        <div class="code-block">
            <span class="comment">// فایل: Components/DownloadComponent.razor</span><br />
            <span class="keyword">&#64;code</span> {<br />
            &nbsp;&nbsp;[Inject] <span class="keyword">private</span> IJSRuntime? JS { <span class="keyword">get</span>; <span class="keyword">set</span>; }<br />
            <br />
            &nbsp;&nbsp;<span class="keyword">private async</span> Task <span class="method">DownloadFile</span>()<br />
            &nbsp;&nbsp;{<br />
            &nbsp;&nbsp;&nbsp;&nbsp;<span class="comment">// فراخوانی تابع جاوااسکریپت از C#</span><br />
            &nbsp;&nbsp;&nbsp;&nbsp;<span class="keyword">await</span> JS.<span class="method">InvokeVoidAsync</span>(<br />
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="string">"blazorDownloadFile"</span>,<br />
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="string">"/Download?handler=Download"</span>,<br />
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="string">"blazor-download.pdf"</span>);<br />
            &nbsp;&nbsp;}<br />
            }
        </div>
        <div class="note-box">
            <i class="bi bi-lightbulb"></i>
            <strong>نکته مهم Blazor:</strong> Blazor Server دسترسی مستقیمی به DOM ندارد.
            هر عملیات مرورگری (دانلود، Focus، اسکرول) باید از طریق JS Interop انجام شود.
            کامپوننت Blazor زیر در همین صفحه رندر می‌شود:
        </div>
        <!-- ====================================================================
             رندر کامپوننت Blazor
             ====================================================================
             render-mode="Server" یعنی کامپوننت فقط روی سرور رندر می‌شود
             (نه ServerPrerendered که هم سرور و هم کلاینت رندر می‌کند)
             ==================================================================== -->
        <component type="typeof(DownloadMethods.Components.DownloadComponent)"
                   render-mode="Server" />
    </div>
</div>

