<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OllamaSK.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- OpenAPI داخلی ASP.NET Core (اسکیمای JSON روی /openapi/v1.json) -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />

    <!-- هسته Semantic Kernel -->
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.80.1" />

    <!-- کانکتور رسمی Ollama برای Semantic Kernel (ساخته‌شده روی پکیج OllamaSharp) -->
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.Ollama" Version="1.80.1-alpha" />

    <!-- پکیج OllamaSharp برای ارتباط مستقیم با Ollama (مرحله ۶) -->
    <PackageReference Include="OllamaSharp" Version="5.4.30" />

    <!-- خواندن فایل‌های Word (docx) -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />

    <!-- خواندن فایل‌های Excel (xlsx) -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />

    <!-- دیتابیس SQLite برای تاریخچه مکالمه پایا و ذخیره وکتورهای RAG -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

</Project>
