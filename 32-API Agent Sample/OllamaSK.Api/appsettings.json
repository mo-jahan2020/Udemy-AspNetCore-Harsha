{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Ollama": {
    "Endpoint": "http://localhost:11434",
    "ModelId": "deepseek-r1:7b",
    "EmbeddingModelId": "nomic-embed-text",
    "UseFunctionCalling": true
  },

  "Search": {
    "Provider": "Auto",
    "MaxResults": 5
  },

  "Rag": {
    "ChunkSize": 900,
    "ChunkOverlap": 150,
    "TopK": 4,
    "MaxContextChars": 4500
  },

  "Database": {
    "FileName": "App_Data/ollamask.db"
  },

  "FileProcessing": {
    "MaxFileSizeMB": 10,
    "MaxCharsPerDocument": 12000
  }
}
