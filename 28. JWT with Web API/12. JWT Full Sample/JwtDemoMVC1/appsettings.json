{
  "ConnectionStrings": {
    "SqlServer": "Server=.\\SQLEXPRESS;Database=JwtDemoMvcDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "http://localhost:7221", // تولید کننده توکن فقط این میتواند باشد
