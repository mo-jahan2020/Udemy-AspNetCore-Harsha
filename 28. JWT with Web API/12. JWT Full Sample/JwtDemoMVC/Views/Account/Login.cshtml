@model LoginViewModel
@{
    ViewData["Title"] = "ورود";
}

<div class="auth-card">
    <h1>ورود به حساب</h1>
    <p class="muted">
        با ورود، یک توکن دسترسی JWT (عمر 1 دقیقه) و یک توکن تمدید (عمر 60 دقیقه) برای شما صادر می‌شود.
    </p>

    <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

    <form asp-controller="Account" asp-action="Login" method="post" class="form">
        <div class="form-group">
            <label asp-for="Username"></label>
            <input asp-for="Username" class="input" required maxlength="50" autofocus autocomplete="username" />
            <span asp-validation-for="Username" class="field-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Password"></label>
            <input asp-for="Password" class="input" required autocomplete="current-password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>
        <button type="submit" class="btn btn-primary btn-block">ورود و دریافت توکن</button>
    </form>

    <p class="muted small" style="margin-top:14px">حساب کاربری ندارید؟ <a asp-controller="Account" asp-action="Register">ثبت‌نام کنید</a></p>
</div>
