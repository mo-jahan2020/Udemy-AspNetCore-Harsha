<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>JwtDemoMVC</RootNamespace>
    <!-- تولید فایل XML برای نمایش توضیحات اکشن‌ها در Swagger -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Remove=".gitignore" />
    <None Remove="JwtDemoMVC-Changed-Files-Only.zip" />
  </ItemGroup>

  <ItemGroup>
    <!-- BCrypt: هش امن رمز عبور (جایگزین SHA256 ساده) — توصیه‌ی OWASP -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />

    <!-- پکیج استاندارد احراز هویت JWT Bearer -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />

    <!-- Entity Framework Core + درایور SQL Server -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />

    <!-- برای ساخت Migration در آینده -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Swagger: تولید سند OpenAPI + رابط تعاملی Swagger UI (آدرس /swagger) -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

</Project>
