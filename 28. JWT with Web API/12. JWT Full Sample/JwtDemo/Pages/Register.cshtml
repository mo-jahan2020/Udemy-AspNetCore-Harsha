@page
@model JwtDemo.Pages.RegisterModel
@{
    ViewData["Title"] = "ثبت‌نام";
}

<div class="auth-card">
    <h1>ثبت‌نام</h1>
    <p class="muted">با ساخت حساب، بلافاصله وارد می‌شوید و توکن‌های JWT برای شما صادر می‌شود.</p>

    <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

    <form method="post" class="form">
        <div class="form-group">
            <label asp-for="Username"></label>
            <input asp-for="Username" class="input" required minlength="3" maxlength="50" autocomplete="username" />
            <span asp-validation-for="Username" class="field-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Password"></label>
            <input asp-for="Password" class="input" required minlength="4" autocomplete="new-password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" class="input" required autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>
        <button type="submit" class="btn btn-primary btn-block">ثبت‌نام و ورود</button>
    </form>

    <p class="muted small" style="margin-top:14px">قبلاً ثبت‌نام کرده‌اید؟ <a asp-page="/Login">وارد شوید</a></p>
</div>
