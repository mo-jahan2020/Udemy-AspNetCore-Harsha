# Vanna Microservice Configuration
# فایل: .env  (این فایل را در همان پوشه vanna-service قرار دهید)

# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder

# Target Database (SQL Server) - برای Vanna که نیاز به اتصال دارد
# این ConnectionString همان دیتابیس هدف کاربر است
TARGET_DATABASE_URL=mssql+pyodbc:///?odbc_connect=Driver%3D%7BODBC+Driver+18+for+SQL+Server%7D%3BServer%3Dlocalhost%5CSQLEXPRESS%3BDatabase%3DSampleDb%3BTrusted_Connection%3Dyes%3BTrustServerCertificate%3Dyes

# Service port
VANNA_SERVICE_PORT=8001

# Logging
LOG_LEVEL=INFO
