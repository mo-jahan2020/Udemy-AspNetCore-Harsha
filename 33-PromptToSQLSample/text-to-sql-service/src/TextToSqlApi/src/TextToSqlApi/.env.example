# TextToSqlApi Environment Variables Override Example
# File: .env (در همان پوشه‌ای که docker-compose اجرا می‌شود)

# Override Ollama settings
Ollama__BaseUrl=http://ollama:11434
Ollama__Model=qwen2.5-coder
Ollama__TimeoutSeconds=180

# Override Vanna settings
Vanna__BaseUrl=http://vanna-service:8001
Vanna__EnableFallbackToOllama=true

# Override App settings
App__Port=5000
App__CorsOrigins__0=http://localhost:3000
App__ApplyMigrationsOnStartup=true

# Override Connection Strings
ConnectionStrings__TargetDatabase=Server=sqlserver;Database=SampleDb;User Id=sa;Password=Your_Strong_Password123!;TrustServerCertificate=True;
ConnectionStrings__SessionDatabase=Server=sqlserver;Database=TextToSqlSessions;User Id=sa;Password=Your_Strong_Password123!;TrustServerCertificate=True;

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Production
