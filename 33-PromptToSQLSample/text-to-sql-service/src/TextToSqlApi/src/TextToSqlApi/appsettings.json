{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/texttosql-.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "TargetDatabase": "Server=localhost\\SQLEXPRESS;Database=SampleDb;Trusted_Connection=True;TrustServerCertificate=True;",
    "SessionDatabase": "Server=localhost\\SQLEXPRESS;Database=TextToSqlSessions;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "qwen2.5-coder",
    "TimeoutSeconds": 120,
    "Temperature": 0.2,
    "MaxTokens": 1024
  },
  "Vanna": {
    "BaseUrl": "http://localhost:8001",
    "TimeoutSeconds": 180,
    "EnableFallbackToOllama": true
  },
  "App": {
    "Port": 5000,
    "CorsOrigins": [ "http://localhost:3000", "http://localhost:8080" ],
    "EnableSqlExecution": true,
    "ApplyMigrationsOnStartup": true
  },
  "AllowedHosts": "*"
}
