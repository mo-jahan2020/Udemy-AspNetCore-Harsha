<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- ═══════════════════════════════════════════════════════════════
       AsvsLab نسخه ۲ — آزمایشگاه آموزشی OWASP ASVS 5.0
       بند مرتبط: V15.1.1/V15.1.2 — فهرست وابستگی‌های شخص ثالث (SBOM)
       پیش‌نیاز سرویس‌ها:
         - Redis (فقط برای دموی قفل‌گذاری توزیع‌شده در V6) — اگر نصب نباشد برنامه با پیام راهنما ادامه می‌دهد
         - هیچ سرویس دیگری لازم نیست؛ دیتابیس دموها درون‌حافظه‌ای است
       ═══════════════════════════════════════════════════════════════ -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AsvsLab</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- بند V15.2.1 — استفاده از نسخه‌های به‌روز کتابخانه‌ها (بدون آسیب‌پذیری شناخته‌شده) -->
    <!-- Microsoft.Data.Sqlite: برای دموی واقعی SQL Injection (دیتابیس درون‌حافظه‌ای) -->
    <!-- نسخه پچ به‌روز برای رفع آسیب‌پذیری SQLitePCLRaw (بند V15.2.1 — وابستگی بدون آسیب‌پذیری) -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.11" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <!-- StackExchange.Redis: فقط برای دموی V6 (قفل‌گذاری توزیع‌شده) — نیاز به سرویس Redis روی localhost:6379 -->
    <PackageReference Include="StackExchange.Redis" Version="2.8.0" />
  </ItemGroup>

  <!-- فایل داده بندهای رسمی ASVS 5.0 (۳۴۵ بند استخراج‌شده از مخزن رسمی OWASP) -->
  <ItemGroup>
    <Content Update="Data\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
