@model RegisterViewModel
@{
    ViewData["Title"] = "ثبت‌نام";
}
<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="chapter-card p-4">
            <h3 class="mb-1">📝 ثبت‌نام</h3>
            <p class="text-muted small">
                گذرواژه شما با PBKDF2 (بند V11.4.2) هش می‌شود و پیش از پذیرش در برابر فهرست لو رفته بررسی می‌شود (بند V6.2.12).
                حداقل ۸ کاراکتر (توصیه: ۱۵) — بدون الزام علائم خاص (بند V6.2.5).
            </p>

            @if (Model.PolicyErrors.Count > 0)
            {
                <div class="alert alert-danger">
                    <b>سیاست گذرواژه رعایت نشد:</b>
                    <ul class="mb-0 mt-1">
                        @foreach (var err in Model.PolicyErrors)
                        {
                            <li>@err</li>
                        }
                    </ul>
                </div>
            }

            <form asp-action="Register" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label" for="Username">نام کاربری</label>
                    <input type="text" id="Username" name="Username" value="@Model.Username" class="form-control" dir="ltr" autocomplete="username" />
                    <span class="text-danger small">@Html.ValidationMessage("Username")</span>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="FullName">نام و نام خانوادگی</label>
                    <input type="text" id="FullName" name="FullName" value="@Model.FullName" class="form-control" />
                    <span class="text-danger small">@Html.ValidationMessage("FullName")</span>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="Password">گذرواژه</label>
                    <input type="password" id="Password" name="Password" class="form-control" dir="ltr" autocomplete="new-password" />
                    <span class="text-danger small">@Html.ValidationMessage("Password")</span>
                </div>
                <button type="submit" class="btn btn-success w-100">ثبت‌نام و ورود</button>
            </form>
        </div>
    </div>
</div>
