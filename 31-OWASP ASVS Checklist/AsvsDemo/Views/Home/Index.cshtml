@{ ViewData["Title"] = "مرکز یکپارچه OWASP ASVS"; }
<div class="text-center" dir="rtl">
    <h1 class="display-4 mb-4">مرکز یکپارچه نمایش بندهای OWASP ASVS</h1>
    <p class="lead text-muted">این پروژه ۱۱ بند از استاندارد OWASP ASVS را در یک مکان پوشش می‌دهد.</p>
    
    <div class="row mt-4">
        <div class="col-md-4 mb-3">
            <div class="card h-100 border-primary">
                <div class="card-body">
                    <h5 class="card-title text-primary">V2.1.1: اعتبارسنجی رمز عبور</h5>
                    <a asp-controller="Authentication" asp-action="Index" class="btn btn-primary w-100">ورود به دمو</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card h-100 border-info">
                <div class="card-body">
                    <h5 class="card-title text-info">V3.2.1: کوکی امن نشست</h5>
                    <a asp-controller="Session" asp-action="Index" class="btn btn-info w-100 text-white">ورود به دمو</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card h-100 border-primary">
                <div class="card-body">
                    <h5 class="card-title text-primary">V4.1.1: کنترل دسترسی</h5>
                    <a asp-controller="Authorization" asp-action="Index" class="btn btn-primary w-100">ورود به دمو</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card h-100 border-warning">
                <div class="card-body">
                    <h5 class="card-title text-warning">V5.1.2: جلوگیری از XSS</h5>
                    <a asp-controller="InputValidation" asp-action="Index" class="btn btn-warning w-100">ورود به دمو</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card h-100 border-info">
                <div class="card-body">
                    <h5 class="card-title text-info">V6.1.1: رمزنگاری داده</h5>
                    <a asp-controller="Cryptography" asp-action="Index" class="btn btn-info w-100 text-white">ورود به دمو</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card h-100 border-warning">
                <div class="card-body">
                    <h5 class="card-title text-warning">V7.1.2/V7.1.3: لاگ و مدیریت خطا</h5>
                    <a asp-controller="Logging" asp-action="Index" class="btn btn-warning w-100">ورود به دمو</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card h-100 border-success">
                <div class="card-body">
                    <h5 class="card-title text-success">V8.1.1: محافظت CSRF</h5>
                    <a asp-controller="RequestProtection" asp-action="Index" class="btn btn-success w-100">ورود به دمو</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card h-100 border-danger">
                <div class="card-body">
                    <h5 class="card-title text-danger">V11.1.1: Rate Limiting</h5>
                    <a asp-controller="BusinessLogic" asp-action="Index" class="btn btn-danger w-100">ورود به دمو</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card h-100 border-secondary">
                <div class="card-body">
                    <h5 class="card-title text-secondary">V12.3.3: آپلود امن فایل</h5>
                    <a asp-controller="FileUpload" asp-action="Index" class="btn btn-secondary w-100">ورود به دمو</a>
                </div>
            </div>
        </div>
    </div>
    
    <div class="alert alert-light mt-4" role="alert">
        <strong>توجه:</strong> بند V14.1.1 (هدرهای امنیتی HTTP) به صورت خودکار در تمام صفحات اعمال می‌شود.
    </div>
</div>
