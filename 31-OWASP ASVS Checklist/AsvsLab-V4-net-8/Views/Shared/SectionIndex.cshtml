@model AsvsLab.Models.SectionCatalog
@{
    ViewData["Title"] = Model.Title;
}

<div class="d-flex flex-wrap justify-content-between align-items-start mb-3 gap-2">
    <div>
        <h2 class="page-title mb-1">@Model.Title</h2>
        <span class="text-muted">فصل استاندارد: <strong>@Model.ChapterRef</strong></span>
    </div>
    <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">🏠 داشبورد</a>
</div>

<p class="text-muted">برای اجرای هر دمو روی دکمه آن کلیک کنید:</p>

<div class="list-group shadow-sm">
    @foreach (var demo in Model.Demos)
    {
        <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center flex-wrap gap-2"
           asp-controller="@(ViewContext.RouteData.Values["controller"])" asp-action="@demo.Action">
            <span class="fw-bold">@demo.Title</span>
            <span class="badge bg-dark">@demo.AsvsRef</span>
        </a>
    }
</div>
