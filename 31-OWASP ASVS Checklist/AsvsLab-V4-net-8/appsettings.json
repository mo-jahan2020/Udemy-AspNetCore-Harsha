{
  // ============================================================================
  // ⚙️ بند V6.4.1 استاندارد OWASP ASVS 4.0.3:
  // «برای ایجاد، ذخیره و نابودی امن مقادیر محرمانه (Secrets) باید از راهکار
  //  مدیریت اسرار مانند Key Vault استفاده شود»
  //
  // ⚠️ هشدار آموزشی: قرار دادن مقادیر محرمانه واقعی در appsettings.json روش
  // درستی نیست، چون این فایل همراه سورس‌کد به مخزن Git می‌رود!
  // روش صحیح در محیط توسعه: User Secrets با دستورهای زیر:
  //   dotnet user-secrets init
  //   dotnet user-secrets set "DemoSettings:FakeApiKey" "12345-SECRET"
  // و در محیط عملیاتی: متغیر محیطی یا Azure Key Vault / HashiCorp Vault
  // ============================================================================
  "DemoSettings": {
    // این مقدار عمداً «نمادین» است؛ دموی پیکربندی امن نشان می‌دهد
    // چگونه چنین مقادیری را از این فایل خارج کنیم
    "FakeApiKey": "این-مقدار-در-فایل-تنظیمات-است-و-ریسک-افشا-دارد"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
